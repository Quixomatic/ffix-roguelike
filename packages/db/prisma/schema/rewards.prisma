/// Reward and gear-availability tables: our own game design (.plans/rewards.md), not FF9 data. Seeded from
/// packages/db/seed/rewards on server startup — missing rows only, so edits from the admin page are never
/// overwritten — and loaded into game-data's reward registry (`registerRewardTables`). `data` holds the whole
/// game-data record (RewardRarity, RewardRole, RewardSource, RewardBoon, GearAvailability).

/// A reward rarity (common … legendary): colour, AP surge, gil, supplies, next-band chance.
model RewardRarity {
  id        String   @id
  sort      Int
  data      Json
  updatedAt DateTime @updatedAt

  @@map("reward_rarity")
}

/// What a character values when judging gear upgrades (stat weights, ability weight).
model RewardRole {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("reward_role")
}

/// Rules per reward source (surprise, elite, treasure, semiboss, boss): cards, weights, guarantee, skip gil.
model RewardSource {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("reward_source")
}

/// A named run-long boon (stat, scope, amount per rarity).
model RewardBoon {
  id        String   @id
  name      String
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("reward_boon")
}

/// How one gear piece can show up in runs: map pools per area, catalog, legendary. Every gear piece has a row.
model GearAvailability {
  itemId    Int      @id
  name      String
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("gear_availability")
}

/// An achievement: its condition (as data), its one-time reward, category, order. `data` is game-data's AchievementData.
/// Which ones a player has earned is player_profile.achievements (ids).
model Achievement {
  id        String   @id
  category  String
  sort      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("achievement")
}

/// One tier of a character's starting-gear upgrade chain (.plans/starter-upgrades.md): item, gil + CP cost, minimum
/// start level, optional journey / achievement requirement. `data` is game-data's StarterUpgrade.
model StarterUpgrade {
  id        String   @id
  character String
  slot      String
  tier      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([character])
  @@map("starter_upgrade")
}

/// A relic (.plans/relics-and-synergies.md): run-long passive with effects as data. `data` is game-data's RelicData.
/// Which ones a player has unlocked is player_profile.relicsUnlocked (plus relics flagged `free`).
model Relic {
  id        String   @id
  sort      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("relic")
}

/// A party synergy: tiers by how many active party members share its tag. `data` is game-data's SynergyData.
model Synergy {
  id        String   @id
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("synergy")
}

/// A character's synergy tags (Tantalus, Summoner, Knight…).
model CharacterTag {
  character String   @id
  tags      String[] @default([])
  updatedAt DateTime @updatedAt

  @@map("character_tag")
}

/// A journey grouping (.plans/journey-groups.md): 2+ journeys played as one run, their maps end to end. Journeys
/// not in one have no row and play on their own. Set on the admin page. `data` is game-data's JourneyGroupData.
model JourneyGroup {
  id        String   @id
  sort      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("journey_group")
}

/// An area: one overworld map — its look, fights, boss, shops and map shape (game-data `AreaData`).
/// `index` is the area's permanent number (saved runs hold it); a new area takes the next free one, never a reused one.
model Area {
  id        String   @id
  index     Int      @unique
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("area")
}

/// A section of the Challenges page — side journeys, hidden bosses… (game-data `ChallengeCategoryData`).
model ChallengeCategory {
  id        String   @id
  sort      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("challenge_category")
}

/// A challenge: its own maps, a journey grouping or a journey, with what opens it and its rules
/// (game-data `ChallengeData`).
model Challenge {
  id        String   @id
  sort      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("challenge")
}

/// A story journey: an ordered list of areas played as a run, its unlock chain and recruits (game-data `JourneyData`).
model Journey {
  id        String   @id
  sort      Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("journey")
}
