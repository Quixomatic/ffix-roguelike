/// Supplies bought at camp (FF9 consumable item id → count), packed into the next run.
model StashItem {
  id        String        @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemId    Int
  count     Int           @default(1)

  @@unique([profileId, itemId])
  @@map("stash_item")
}
