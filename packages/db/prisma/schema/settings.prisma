/// A user's preferences (menus and battle presentation). One row per user, created on first save; missing = defaults.
model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Menu font id — the web app's font sets in index.css: rounded | classic | pixel | storybook.
  menuFont    String  @default("rounded")
  /// Pixel font id — the font sets' pixel text (headings, Classic's everything, in-game labels): pixelify | silkscreen | jersey.
  pixelFont   String  @default("silkscreen")
  /// Battle animation speed multiplier the battle screen starts at (1, 2 or 4).
  battleSpeed Int     @default(1)
  /// Start battles with the Auto battle toggle on.
  autoBattle  Boolean @default(false)
  /// Music volume, 0–100 (0 = off).
  musicVolume Int     @default(25)
  /// Sound effect volume, 0–100 (0 = off).
  sfxVolume   Int     @default(25)

  updatedAt DateTime @updatedAt

  @@map("user_settings")
}
