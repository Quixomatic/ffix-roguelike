/// A player's permanent progression — one per user, created on first visit to the game.
/// Mirrors game-core's `Profile` (packages/game-core/src/meta/profile.ts); the API maps between the two.
model PlayerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Banked gil (half of a lost run's gil, all of a won run's).
  gil     Int @default(0)
  /// Highest difficulty tier the player may start. Winning at the current max unlocks the next.
  maxTier Int @default(0)

  /// Battle preference: wait (time stops while choosing) or active.
  battleMode BattleMode @default(WAIT)

  // Lifetime stats (drive character unlocks).
  runs           Int @default(0)
  wins           Int @default(0)
  battles        Int @default(0)
  eaten          Int @default(0)
  steals         Int @default(0)
  bestWorld      Int @default(0)
  highestTierWon Int @default(-1)
  /// Characters who won a run as the only party member.
  soloWins       String[] @default([])
  /// Characters in the party when the final journey (Terra & Memoria) was cleared.
  legendClears   String[] @default([])

  /// Earned achievement ids (game-core meta/achievements.ts).
  achievements String[] @default([])
  /// Gear unlocked into run drop pools (catalog, achievements, won runs) — FF9 item ids.
  gearUnlocked Int[]    @default([])
  /// Relics unlocked into the player's collection by achievements (relic ids; `free` relics needn't be listed).
  relicsUnlocked String[] @default([])
  /// Reward rerolls / bans per run (charges; earned or bought later — .plans/rewards.md §3.9). Not used yet.
  rewardRerolls Int @default(0)
  rewardBans    Int @default(0)
  /// Camp supply ranks: FF9 item id → extra copies every run starts with (game-core SUPPLY_MAX).
  supplyRanks  Json     @default("{}")
  /// Journeys cleared at least once (each unlocks the next) — game-core JOURNEYS ids.
  journeysCleared String[] @default([])
  /// Journey groupings won at least once (challenge achievements; .plans/journey-groups.md).
  groupsCleared String[] @default([])

  characters PlayerCharacter[]
  stash      StashItem[]
  bossKills  BossKill[]
  routeTiers PlayerRouteTier[]
  runsList   Run[]
  metrics    PlayerMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_profile")
}

enum BattleMode {
  WAIT
  ACTIVE
}

/// A lifetime metric (game-core metrics/registry.ts): the player's total (`character` "") or one character's, overall
/// (`subject` "") or for one subject (an enemy, item, ability, journey…). Sums add up, records keep the best. Added to
/// in the same transaction that saves a run (from the server's verified battle replays) or a camp action.
model PlayerMetric {
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  character String        @default("")
  key       String
  subject   String        @default("")
  value     Float
  updatedAt DateTime      @updatedAt

  @@id([profileId, character, key, subject])
  @@index([key, subject, character])
  @@map("player_metric")
}

/// How many times the player has beaten each boss (game-core enemy id, e.g. "garland").
model BossKill {
  id        String        @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  enemyId   String
  count     Int           @default(0)

  @@unique([profileId, enemyId])
  @@map("boss_kill")
}

/// The best tier a player has won on a route: a story journey, a challenge or a grouping (game-core `routeTiers`).
/// Tier n+1 opens on that route once tier n is won.
model PlayerRouteTier {
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// A journey, challenge or grouping id.
  routeId   String
  /// 0 = Normal.
  bestTier  Int
  updatedAt DateTime      @updatedAt

  @@id([profileId, routeId])
  @@index([routeId, bestTier])
  @@map("player_route_tier")
}
