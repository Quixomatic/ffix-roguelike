/// A player's permanent progression — one per user, created on first visit to the game.
/// Mirrors game-core's `Profile` (packages/game-core/src/meta/profile.ts); the API maps between the two.
model PlayerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Banked gil (half of a lost run's gil, all of a won run's).
  gil     Int @default(0)
  /// Highest difficulty tier the player may start. Winning at the current max unlocks the next.
  maxTier Int @default(0)

  /// Battle preference: wait (time stops while choosing) or active.
  battleMode BattleMode @default(WAIT)

  // Lifetime stats (drive character unlocks).
  runs           Int @default(0)
  wins           Int @default(0)
  battles        Int @default(0)
  eaten          Int @default(0)
  steals         Int @default(0)
  bestWorld      Int @default(0)
  highestTierWon Int @default(-1)
  /// Characters who won a run as the only party member.
  soloWins       String[] @default([])
  /// Characters in the party when the final journey (Terra & Memoria) was cleared.
  legendClears   String[] @default([])

  /// Earned achievement ids (game-core meta/achievements.ts).
  achievements String[] @default([])
  /// Gear unlocked into run drop pools (catalog, achievements, won runs) — FF9 item ids.
  gearUnlocked Int[]    @default([])
  /// Reward rerolls / bans per run (charges; earned or bought later — .plans/rewards.md §3.9). Not used yet.
  rewardRerolls Int @default(0)
  rewardBans    Int @default(0)
  /// Camp supply ranks: FF9 item id → extra copies every run starts with (game-core SUPPLY_MAX).
  supplyRanks  Json     @default("{}")
  /// Journeys cleared at least once (each unlocks the next) — game-core JOURNEYS ids.
  journeysCleared String[] @default([])

  characters PlayerCharacter[]
  stash      StashItem[]
  bossKills  BossKill[]
  runsList   Run[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_profile")
}

enum BattleMode {
  WAIT
  ACTIVE
}

/// How many times the player has beaten each boss (game-core enemy id, e.g. "garland").
model BossKill {
  id        String        @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  enemyId   String
  count     Int           @default(0)

  @@unique([profileId, enemyId])
  @@map("boss_kill")
}
