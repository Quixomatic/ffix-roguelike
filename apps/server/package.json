{
  "name": "server",
  "version": "0.1.84",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun ../../scripts/dev-server.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
  },
  "dependencies": {
    "@ffix-roguelike/api": "workspace:*",
    "@ffix-roguelike/auth": "workspace:*",
    "@ffix-roguelike/db": "workspace:*",
    "@ffix-roguelike/game-core": "workspace:*",
    "@ffix-roguelike/game-data": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ffix-roguelike/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
