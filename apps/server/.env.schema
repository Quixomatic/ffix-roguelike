# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Extra allowed web origins beyond CORS_ORIGIN (ChannelGuide's): a comma-separated list of exact origins, e.g. the www
# address alongside the bare domain: EXTRA_CORS_ORIGINS=https://www.ff-like.xyz
# @optional @sensitive=false
EXTRA_CORS_ORIGINS=

# @type=string(minLength=1)
DATABASE_URL=

# --- Social sign-in (better-auth). Each provider is on only when both its id and secret are set (ChannelGuide's
# pattern). Redirect URI to register with the provider: <BETTER_AUTH_URL>/api/auth/callback/google (or /github),
# in development http://localhost:3000/api/auth/callback/google. ---
# @optional @sensitive=false
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=
# @optional @sensitive=false
GITHUB_CLIENT_ID=
# @optional
GITHUB_CLIENT_SECRET=

# --- Cloudflare R2 (S3-compatible object storage: game assets, user uploads). Optional — unset = not configured. ---
# @optional
CLOUDFLARE_R2_ACCOUNT_ID=
# @optional
CLOUDFLARE_R2_ACCESS_KEY_ID=
# @optional
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# @optional @sensitive=false
CLOUDFLARE_R2_BUCKET_NAME=
# @optional @sensitive=false @type=url
CLOUDFLARE_R2_PUBLIC_URL=
