# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Base URL game assets are served from (the R2 bucket's public URL + "/assets/<version>"). Unset = the app's own /public files.
# @optional @public @type=url
VITE_ASSET_BASE_URL=

# Umami analytics (ChannelGuide's self-hosted instance): the tracker script's URL, e.g. https://umami.turboforge.io/script.js.
# Loaded only by production builds with both Umami vars set, so local dev doesn't count against the stats.
# @optional @public @type=url
VITE_UMAMI_SRC=

# The site's id in Umami (Settings → Websites).
# @optional @public
VITE_UMAMI_WEBSITE_ID=
