# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Base URL game assets are served from (the R2 bucket's public URL + "/assets/<version>"). Unset = the app's own /public files.
# @optional @public @type=url
VITE_ASSET_BASE_URL=

# Umami analytics (ChannelGuide's self-hosted instance): the tracker script's URL, e.g. https://umami.turboforge.io/script.js.
# Loaded only by production builds with both Umami vars set, so local dev doesn't count against the stats.
# @optional @public @type=url
VITE_UMAMI_SRC=

# The site's id in Umami (Settings → Websites).
# @optional @public
VITE_UMAMI_WEBSITE_ID=

# Ads on (true) or off (false or unset): the run's sidebar and the hub's corner, placeholders in dev included.
# ads.txt and AdSense's verification tag still follow VITE_ADSENSE_CLIENT, so the site stays verified while ads are off.
# @optional @public @type=boolean
VITE_ADS_ENABLED=

# Google AdSense publisher id ("ca-pub-…"). Unset = no ads (and no ads.txt / verification meta in the build).
# @optional @public
VITE_ADSENSE_CLIENT=

# The AdSense display ad unit's slot id (Ads → By ad unit → Display ads). The page sets each ad's size (300×250, or
# 300×100 / 300×50 where the run's sidebar has less room), so the unit itself can be the default responsive one.
# @optional @public
VITE_ADSENSE_SLOT=
