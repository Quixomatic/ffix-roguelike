{
  "name": "ffix-roguelike",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "version:bump": "bun scripts/bump-version.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check-fast": "turbo run check-fast",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @ffix-roguelike/db --",
    "db:studio": "turbo run db:studio -F @ffix-roguelike/db --",
    "db:generate": "turbo run db:generate -F @ffix-roguelike/db --",
    "db:migrate": "turbo run db:migrate -F @ffix-roguelike/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "sim": "pnpm -s -F @ffix-roguelike/game-core sim"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ffix-roguelike/config": "workspace:*",
    "@types/bun": "catalog:",
    "portless": "0.15.8",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@10.34.7"
}
