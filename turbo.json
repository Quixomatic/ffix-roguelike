{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    // `check-fast` = `bun check` (the TS7 type checker) per workspace. Named `check-fast`, not `check`,
    // because `bun check` runs a `check` script if one exists, which would recurse. `^check-fast` so a
    // dependency's errors invalidate its dependents' cached results (no masking).
    "check-fast": {
      "dependsOn": ["^check-fast"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": false
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "VITE_SERVER_URL",
    "_VARLOCK_ENV_KEY"
  ],
  // portless (https://ffix.localhost, https://api.ffix.localhost): let its settings through to `dev`, e.g.
  // `PORTLESS=0 pnpm dev` to skip the proxy and use the old ports.
  "globalPassThroughEnv": ["PORTLESS", "PORTLESS_*"],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
